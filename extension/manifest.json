{
  "manifest_version": 3,
  "name": "Link Keeper",
  "version": "5.20",
  "description": "Walk a list of saved links one at a time in your own tab, capture the ones worth keeping, export the lot as a file.",
  "browser_specific_settings": {
    "gecko": {
      "id": "link-keeper@mrtysn.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "bookmarks",
    "cookies",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "scripting",
    "activeTab",
    "menus",
    "downloads",
    "notifications",
    "downloads.open"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "*://t.co/*"
  ],
  "background": {
    "scripts": [
      "links.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Keeper",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "Keep this page"
    },
    "next-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "MacCtrl+Shift+J"
      },
      "description": "Go to the next link in the list"
    },
    "queue-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Add this page to the list"
    },
    "skip-link": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "MacCtrl+Shift+X"
      },
      "description": "Skip this link and go to the next"
    },
    "stash-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Stash the selected tabs, or the whole window, and close them"
    },
    "stash-this-tab": {
      "description": "Stash only this tab"
    },
    "show-stashed": {
      "description": "Show stashed tabs"
    }
  },
  "optional_host_permissions": [
    "*://*/*"
  ]
}
