{
  "manifest_version": 3,
  "name": "Link Keeper",
  "version": "1.1",
  "description": "Walk a list of saved links one at a time in your own tab, capture the ones worth keeping, export the lot as a file.",

  "browser_specific_settings": {
    "gecko": {
      "id": "link-keeper@mrtysn.github.io",
      "strict_min_version": "128.0"
    }
  },

  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "activeTab"],

  "host_permissions": ["*://t.co/*"],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Link Keeper",
    "default_icon": "icon.svg"
  },

  "icons": { "48": "icon.svg", "96": "icon.svg" },

  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "MacCtrl+Shift+K" },
      "description": "Keep this page"
    },
    "next-link": {
      "suggested_key": { "default": "Ctrl+Shift+J", "mac": "MacCtrl+Shift+J" },
      "description": "Go to the next link in the list"
    },
    "queue-page": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "MacCtrl+Shift+U" },
      "description": "Add this page to the list"
    }
  }
}
